{
  "name": "kora-agentgate",
  "version": "0.2.0-beta.0",
  "private": false,
  "type": "module",
  "description": "Verify coding agent completion claims with executable task contracts",
  "bin": {
    "agentgate": "./agentgate.mjs",
    "agentgate-protected": "./protected-runner.mjs"
  },
  "files": [
    "agentgate.mjs",
    "protected-runner.mjs",
    "README.md",
    "examples/pass.json",
    "examples/fail.json",
    "examples/claude-settings.example.json",
    "docs/PROTECTED_LAUNCHER_PREVIEW.md",
    "scripts/protected-smoke.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node agentgate.mjs verify --contract examples/pass.json",
    "test:isolation": "node scripts/macos-contract-isolation-smoke.mjs",
    "test:preview": "node protected-runner.mjs --self-test"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krako-Labs/kora-agentgate.git"
  }
}
